# Runtime paths (relative DATABASE_PATH values resolve from PROJECT_ROOT)
PROJECT_ROOT=.
DATABASE_PATH=data/precos.sqlite

# Collection safety limits
PAGE_CONCURRENCY=4
DAILY_PAGE_CAP=2000

# Optional integrations; leave blank when unused
OPENAI_API_KEY=
# Optional shared base URL for classification and explorer fallback; defaults to api.openai.com.
OPENAI_BASE_URL=
CODEX_API_KEY=
# Optional explorer-only base URL override; falls back to OPENAI_BASE_URL.
CODEX_BASE_URL=
OPENAI_CLASSIFICATION_MODEL=gpt-5.6-luna
OPENAI_EXPLORER_MODEL=gpt-5.6-sol
# Explorer reasoning effort: none, low, medium, high, or xhigh (default: high).
OPENAI_EXPLORER_REASONING_EFFORT=high
# Explorer turn timeout in milliseconds (30000–1800000; default: 480000).
OPENAI_EXPLORER_TIMEOUT_MS=480000
# Conservative budgeting estimates only (USD/million tokens), not claimed prices.
# Override both together and give the operator-controlled rate a version.
OPENAI_EXPLORER_INPUT_USD_PER_MILLION=10
OPENAI_EXPLORER_OUTPUT_USD_PER_MILLION=60
OPENAI_EXPLORER_RATE_VERSION=operator-reviewed-YYYY-MM-DD
NTFY_TOPIC=

# Application timestamps always use this timezone semantic.
TZ=America/Sao_Paulo
