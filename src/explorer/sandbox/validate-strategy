#!/usr/bin/env node

import { readFile } from "node:fs/promises";

const value = JSON.parse(await readFile("strategy.json", "utf8"));
if (value === null || typeof value !== "object" || Array.isArray(value)) {
  throw new Error("strategy.json must contain an object");
}
if (Object.keys(value).length !== 1 || !("strategy" in value)) {
  throw new Error("Expected strict root object with only strategy");
}
const strategy = value.strategy;
if (strategy === null || typeof strategy !== "object" || Array.isArray(strategy)) {
  throw new Error("strategy must be an object");
}
if (strategy.schemaVersion !== 1) throw new Error("schemaVersion must be 1");
if (strategy.purpose !== "extraction" && strategy.purpose !== "discovery") {
  throw new Error("purpose must be extraction or discovery");
}
if (!Array.isArray(strategy.allowedDomains) || strategy.allowedDomains.length === 0) {
  throw new Error("allowedDomains must be a non-empty array");
}
process.stdout.write("Artifact has the required root shape. Trusted host validation is still required.\n");
