[Unit]
Description=Classify newly collected supermarket products incrementally
After=precos-daily.service

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=@RUNTIME_PATH@
Environment=TZ=America/Sao_Paulo
EnvironmentFile=@ENV_FILE@
UMask=0077
ExecStart=@NODE_PATH@ @CLI_PATH@ classify --batch-size 50 --version 1 --json
