[Unit]
Description=Check daily price-collection heartbeat

[Service]
Type=oneshot
WorkingDirectory=@RELEASE_ROOT@
Environment=@RUNTIME_PATH@
Environment=TZ=America/Sao_Paulo
Environment=@RELEASE_ID_ENV@
EnvironmentFile=@ENV_FILE@
UMask=0077
ExecStartPre=@NODE_PATH@ @RELEASE_VERIFY_PATH@ verify @RELEASE_ROOT_QUOTED@ @PUBLIC_KEY_PATH@
ExecStart=@NODE_PATH@ @CLI_PATH@ heartbeat check --json
