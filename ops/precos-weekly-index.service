[Unit]
Description=Export the experimental index and thesis analysis weekly
After=network-online.target precos-daily.service precos-weekly-discovery.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@RELEASE_ROOT@
Environment=@RUNTIME_PATH@
Environment=TZ=America/Sao_Paulo
Environment=@RELEASE_ID_ENV@
EnvironmentFile=@ENV_FILE@
UMask=0077
ExecStartPre=@NODE_PATH@ @RELEASE_VERIFY_PATH@ verify @RELEASE_ROOT_QUOTED@ @PUBLIC_KEY_PATH@
ExecStart=@BASH_PATH@ @WEEKLY_INDEX_PATH@
