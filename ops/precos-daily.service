[Unit]
Description=Collect daily supermarket prices
After=network-online.target
Wants=network-online.target
OnSuccess=precos-classification.service
RefuseManualStart=yes

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=@RUNTIME_PATH@
Environment=TZ=America/Sao_Paulo
EnvironmentFile=@ENV_FILE@
Environment=PRECOS_SCHEDULE_SOURCE=systemd-timer
UMask=0077
ExecStart=@NODE_PATH@ @CLI_PATH@ daily --json
