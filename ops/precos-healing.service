[Unit]
Description=Process queued supermarket strategy healing
After=network-online.target precos-daily.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=@RUNTIME_PATH@
Environment=TZ=America/Sao_Paulo
EnvironmentFile=@ENV_FILE@
UMask=0077
ExecStart=@NODE_PATH@ @CLI_PATH@ heal --pending --json
RestartForceExitStatus=TEMPFAIL
RestartSec=5m
