{
  "name": "tcc-ultra-super",
  "version": "0.1.0",
  "private": true,
  "description": "Self-healing online price extraction pilot for a bachelor's thesis.",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "bin": {
    "precos": "dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations dist/explorer dist/scripts && cp src/db/schema.sql dist/db/schema.sql && cp src/db/migrations/*.sql dist/db/migrations/ && cp -R src/explorer/sandbox dist/explorer/ && esbuild scripts/validate-strategies.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/scripts/validate-strategies.js && chmod 0755 dist/cli.js dist/scripts/validate-strategies.js",
    "cli": "tsx src/cli.ts",
    "precos": "tsx src/cli.ts",
    "ipca:load": "tsx scripts/load-ipca-items.ts",
    "retailers:register": "tsx scripts/register-retailers.ts",
    "strategies:key:init": "tsx scripts/init-validation-attestation-key.ts",
    "strategies:validate": "tsx scripts/validate-strategies.ts",
    "analysis:setup": "bash ops/setup-analysis.sh",
    "analysis:test": "vitest run tests/analysis",
    "analysis": "var/analysis-venv/bin/python analysis/generate.py --input data/exports --output analysis/output",
    "research:snapshot": "npm run build && bash ops/run-weekly-index.sh",
    "audit:publication": "tsx scripts/audit-publication.ts",
    "verify:fresh-clone": "bash ops/verify-fresh-clone.sh",
    "acceptance": "tsx ops/acceptance.ts report",
    "acceptance:drill": "tsx ops/acceptance.ts drill",
    "test": "vitest run",
    "test:live": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.1",
    "better-sqlite3": "12.11.1",
    "cheerio": "1.2.0",
    "commander": "15.0.0",
    "csv-parse": "7.0.1",
    "decimal.js": "10.6.0",
    "esbuild": "0.28.1",
    "fast-xml-parser": "5.9.3",
    "jsonpath-plus": "10.4.0",
    "openai": "6.46.0",
    "playwright": "1.61.1",
    "robots-parser": "3.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
